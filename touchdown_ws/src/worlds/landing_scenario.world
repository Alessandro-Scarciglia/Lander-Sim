<!-- Template for the generated landing world. generate_scenario.py replaces
  the pose, velocity, terrain-contact, and plugin parameter placeholders. -->
<sdf version='1.7'>
  <world name='default'>

    <!-- ======================== -->
    <!-- Luce solare (sun)  -->
    <!-- ======================== -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0.6 -0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -1</direction>
      <attenuation>
        <range>10</range>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ======================== -->
    <!-- Terrain (collision + visual) -->
    <!-- ======================== -->
    <model name='terrain_model'>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://terrain_model/meshes/terrain_cropped.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://terrain_model/meshes/terrain_cropped.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <contact>
              <collide_without_contact>0</collide_without_contact>
              <ode>
                <kp>200000.00000</kp>
                <kd>20000.00000</kd>
                <max_vel>0.1</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.1</restitution_coefficient>
              <threshold>1</threshold>
            </bounce>
          </surface>
          <max_contacts>20</max_contacts>
        </collision>
      </link>
    </model>

    <!-- ======================== -->
    <!-- Fisica del mondo -->
    <!-- ======================== -->
    <physics type='ode'>
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>      
      <ode>
        <solver>
          <type>quick</type>
          <iters>80</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>
    <gravity>0 0 -1.625</gravity>

    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic' />

    <!-- ======================== -->
    <!-- Scene (ambient, background, shadows) -->
    <!-- ======================== -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0 0 0 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- ======================== -->
    <!-- Audio e vento -->
    <!-- ======================== -->
    <audio>
      <device>default</device>
    </audio>
    <wind />

    <!-- ======================== -->
    <!-- Coordinate sferiche -->
    <!-- ======================== -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ======================== -->
    <!-- GUI (camera, view) -->
    <!-- ======================== -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>18.0 18.0 -148.0 0 0.18 -2.65</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ======================== -->
    <!-- Inserimento lander modulare -->
    <!-- ======================== -->
    <include>
      <uri>model://lander_model</uri>
      <pose>12.29017 24.17870 -149.80116 0.05152 0.07722 0.04187</pose> <!-- z=30 per partire sopra il
      terreno -->
      <plugin name="initial_velocity_plugin" filename="libInitialVelocityPlugin.so">
        <linear_velocity>-0.47099 -0.03438 -0.30196</linear_velocity>
        <angular_velocity>0.02600 0.06997 -0.06751</angular_velocity>
      </plugin>
    </include>

    <!-- ====================================================== -->
    <!-- Pubblica gli stati dei modelli su ROS    -->
    <!-- ====================================================== -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- ====================================================== -->
    <!-- Plugin Dynamic Terrain    -->
    <!-- ====================================================== -->
    <plugin name="dynamic_terrain" filename="libDynamicTerrainPlugin.so">
      <terrain_name>terrain_model</terrain_name> 
      <kp_surface>200000.00000</kp_surface>
      <kp_rock>5000000.00000</kp_rock>
      <kd_surface>20000.00000</kd_surface> 
      <kd_rock>80000.00000</kd_rock>
      <mu_surface>0.65000</mu_surface>
      <mu_rock>0.85000</mu_rock>
      <dust_thickness>0.05000</dust_thickness>
    </plugin>


  </world>
</sdf>