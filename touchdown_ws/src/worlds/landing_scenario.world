<sdf version='1.7'>
  <world name='default'>

    <!-- ======================== -->
    <!-- 1️⃣ Luce solare (sun)  -->
    <!-- ======================== -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0.6 -0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -1</direction>
      <attenuation>
        <range>10</range>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ======================== -->
    <!-- 2️⃣ Terrain (collision + visual) -->
    <!-- ======================== -->
    <model name='terrain_model'>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://terrain_model/meshes/moon_0.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://terrain_model/meshes/moon_0.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <contact>
              <collide_without_contact>0</collide_without_contact>
              <ode>
                <kp>500</kp>
                <kd>50</kd>
                <max_vel>0.5</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <friction>
              <ode>
                <mu>0.3</mu>
                <mu2>0.3</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.1</restitution_coefficient>
              <threshold>1</threshold>
            </bounce>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
      </link>
    </model>

    <!-- ======================== -->
    <!-- 3️⃣ Fisica del mondo (gravità, timestep, ecc.) -->
    <!-- ======================== -->
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>      
    </physics>
    <gravity>0 0 -1.625</gravity>

    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic' />

    <!-- ======================== -->
    <!-- 4️⃣ Scene (ambient, background, shadows) -->
    <!-- ======================== -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0 0 0 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- ======================== -->
    <!-- 5️⃣ Audio e vento -->
    <!-- ======================== -->
    <audio>
      <device>default</device>
    </audio>
    <wind />

    <!-- ======================== -->
    <!-- 6️⃣ Coordinate sferiche -->
    <!-- ======================== -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ======================== -->
    <!-- 7️⃣ GUI (camera, view) -->
    <!-- ======================== -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>68.1 49.43 28.56 0 0.159981 3.075784</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ======================== -->
    <!-- 8️⃣ Inserimento lander modulare -->
    <!-- ======================== -->
    <include>
      <uri>model://lander_model</uri>
      <pose>56.95641 52.19734 24.78712 -0.01903 0.16787 -0.03294</pose> <!-- z=30 per partire sopra il
      terreno -->
      <plugin name="initial_velocity_plugin" filename="libInitialVelocityPlugin.so">
        <linear_velocity>-0.57098 0.95433 -0.88725</linear_velocity>
        <angular_velocity>-0.02859 0.05827 0.02990</angular_velocity>
      </plugin>
    </include>
    <!-- ====================================================== -->
    <!-- Pubblica gli stati dei modelli su ROS    -->
    <!-- ====================================================== -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>
  </world>
</sdf>