<sdf version='1.7'>
  <world name='default'>

    <!-- ======================== -->
    <!-- Luce solare (sun)  -->
    <!-- ======================== -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0.6 -0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -1</direction>
      <attenuation>
        <range>10</range>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ======================== -->
    <!-- Terrain (collision + visual) -->
    <!-- ======================== -->
    <model name='terrain_model'>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://terrain_model/meshes/terrain_cropped.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://terrain_model/meshes/terrain_cropped.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <contact>
              <collide_without_contact>0</collide_without_contact>
              <ode>
                <kp>{KP_S}</kp>
                <kd>{KD_S}</kd>
                <max_vel>0.0</max_vel>
                <min_depth>0.0</min_depth>
              </ode>
            </contact>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.1</restitution_coefficient>
              <threshold>1</threshold>
            </bounce>
          </surface>
          <max_contacts>20</max_contacts>
        </collision>
      </link>
    </model>

    <!-- ======================== -->
    <!-- Fisica del mondo -->
    <!-- ======================== -->
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>      
    </physics>
    <gravity>0 0 -1.625</gravity>

    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic' />

    <!-- ======================== -->
    <!-- Scene (ambient, background, shadows) -->
    <!-- ======================== -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0 0 0 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- ======================== -->
    <!-- Audio e vento -->
    <!-- ======================== -->
    <audio>
      <device>default</device>
    </audio>
    <wind />

    <!-- ======================== -->
    <!-- Coordinate sferiche -->
    <!-- ======================== -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ======================== -->
    <!-- GUI (camera, view) -->
    <!-- ======================== -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>18.0 18.0 -148.0 0 0.18 -2.65</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ======================== -->
    <!-- Inserimento lander modulare -->
    <!-- ======================== -->
    <include>
      <uri>model://lander_model</uri>
      <pose>{POS_X} {POS_Y} {POS_Z} {ROLL} {PITCH} {YAW}</pose> <!-- z=30 per partire sopra il
      terreno -->
      <plugin name="initial_velocity_plugin" filename="libInitialVelocityPlugin.so">
        <linear_velocity>{VEL_X} {VEL_Y} {VEL_Z}</linear_velocity>
        <angular_velocity>{ANG_X} {ANG_Y} {ANG_Z}</angular_velocity>
      </plugin>
    </include>

    <!-- ====================================================== -->
    <!-- Pubblica gli stati dei modelli su ROS    -->
    <!-- ====================================================== -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- ====================================================== -->
    <!-- Plugin Dynamic Terrain    -->
    <!-- ====================================================== -->
    <plugin name="dynamic_terrain" filename="libDynamicTerrainPlugin.so">
      <terrain_name>terrain_model</terrain_name> 
      <kp_surface>{KP_S}</kp_surface>
      <kp_rock>{KP_R}</kp_rock>
      <kd_surface>{KD_S}</kd_surface> 
      <kd_rock>{KD_R}</kd_rock>
      <mu_surface>{MU_S}</mu_surface>
      <mu_rock>{MU_R}</mu_rock>
      <dust_thickness>{THICK}</dust_thickness>
    </plugin>


  </world>
</sdf>