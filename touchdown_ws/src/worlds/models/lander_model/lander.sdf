<?xml version="1.0"?>
<sdf version="1.7">
  <model name="lander_model">
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- ================= BODY ================= -->
    <include>
      <uri>model://lander_model/body</uri>
      <name>body_instance</name>
    </include>

    <!-- ================= PASSENGER ================= -->
    <include>
      <uri>model://lander_model/passenger</uri>
      <name>passenger</name>
      <pose>0 0 2.464 0 0 0</pose>
    </include>

    <!-- ================= LEGS ================= -->
    <include>
      <uri>model://lander_model/leg1</uri>
      <name>leg1</name>
      <pose relative_to="body_instance::body_link">1.414 1.414 0.6 0.523 -0.523 0</pose>
    </include>

    <include>
      <uri>model://lander_model/leg2</uri>
      <name>leg2</name>
      <pose relative_to="body_instance::body_link">-1.414 1.414 0.6 0.523 0.523 0</pose>
    </include>

    <include>
      <uri>model://lander_model/leg3</uri>
      <name>leg3</name>
      <pose relative_to="body_instance::body_link">-1.414 -1.414 0.6 -0.523 0.523 0</pose>
    </include>

    <include>
      <uri>model://lander_model/leg4</uri>
      <name>leg4</name>
      <pose relative_to="body_instance::body_link">1.414 -1.414 0.6 -0.523 -0.523 0</pose>
    </include>

    <!-- ================= JOINT TEMPLATE ================= -->
    <!-- Rigidità aumentata per evitare attraversamenti -->
    <joint name="payload_interface_joint" type="fixed">
      <parent>body_instance::body_link</parent>
      <child>passenger::passenger_link</child>
    </joint>

    <joint name="leg1_joint" type="fixed">
      <parent>body_instance::body_link</parent>
      <child>leg1::main_strut</child>
    </joint>

    <joint name="leg2_joint" type="fixed">
      <parent>body_instance::body_link</parent>
      <child>leg2::main_strut</child>
    </joint>

    <joint name="leg3_joint" type="fixed">
      <parent>body_instance::body_link</parent>
      <child>leg3::main_strut</child>
    </joint>

    <joint name="leg4_joint" type="fixed">
      <parent>body_instance::body_link</parent>
      <child>leg4::main_strut</child>
    </joint>

  </model>
</sdf>