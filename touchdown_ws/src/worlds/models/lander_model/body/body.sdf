<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="body">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="body_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- ================= INERTIAL ================= -->
      <inertial>
        <mass>50.0</mass>

        <!-- Inerzia coerente con box 1 x 1 x 0.5 -->
        <!-- Ixx = 1/12 m (y² + z²) ecc -->
        <inertia>
          <ixx>5.208</ixx>
          <iyy>5.208</iyy>
          <izz>8.333</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- ================= VISUAL ================= -->
      <visual name="body_visual">
        <geometry>
          <box>
            <size>1 1 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>

      <!-- ================= COLLISION ================= -->
      <collision name="body_collision">
        <geometry>
          <!-- collision leggermente maggiorata -->
          <box>
            <size>1.01 1.01 0.51</size>
          </box>
        </geometry>

        <surface>
          <contact>
            <ode>
              <kp>50000</kp>
              <kd>500</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>

          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1.0</threshold>
          </bounce>
        </surface>

        <max_contacts>20</max_contacts>
      </collision>

    </link>
  </model>
</sdf>
