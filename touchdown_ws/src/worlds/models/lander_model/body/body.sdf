<?xml version="1.0"?>
<sdf version="1.7">
  <model name="body">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="body_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- ================= INERTIAL ================= -->
      <inertial>
        <mass>2821.79809</mass>

        <!-- CoG -->
        <pose>0.01102 0.07481 1.31207 0 0 0</pose>

        <inertia>
          <ixx>5979.25752</ixx>
          <iyy>5882.18754</iyy>
          <izz>5044.44808</izz>
          <ixy>-198.73443</ixy>
          <ixz>50.47560</ixz>
          <iyz>-145.15130</iyz>
        </inertia>
      </inertial>

      <!-- ================= VISUAL ================= -->
      <visual name="body_visual">
        <geometry>
          <mesh>
            <uri>model://lander_model/meshes/body.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>

      <visual name="thruster_central_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://lander_model/meshes/thruster.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="thruster_left_visual">
        <pose>-1.5 0.0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://lander_model/meshes/thruster.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="thruster_right_visual">
        <pose>1.5 0.0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://lander_model/meshes/thruster.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- ================= COLLISION ================= -->
      <collision name="body_collision">
        <geometry>
          <!-- collision leggermente maggiorata -->
          <mesh>
            <uri>model://lander_model/meshes/body.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

        <surface>
          <contact>
            <ode>
              <kp>100000000.0</kp>
              <kd>100000.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>

          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1.0</threshold>
          </bounce>
        </surface>

        <max_contacts>20</max_contacts>
      </collision>

      <!-- ================= lidar ================= -->
      <sensor name="laser_altimeter" type="ray">
        <pose>0 0 0 0 1.5708 0</pose>
        <visualize>true</visualize>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=/lander/laser_altimeter</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>body_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- ================= THRUSTER ================= -->
    <plugin name="thruster_central" filename="libgazebo_ros_thruster.so">
      <link_name>body_link</link_name>
      <ros_topic>/lander/thrusters/central</ros_topic>
      <offset>0 0 -0.1174</offset>
      <direction>0 0 1</direction>
    </plugin>

    <plugin name="thruster_left" filename="libgazebo_ros_thruster.so">
      <link_name>body_link</link_name>
      <ros_topic>/lander/thrusters/left</ros_topic>
      <offset>-1.5 0.0 -0.1174</offset>
      <direction>0 0 1</direction>
    </plugin>

    <plugin name="thruster_right" filename="libgazebo_ros_thruster.so">
      <link_name>body_link</link_name>
      <ros_topic>/lander/thrusters/right</ros_topic>
      <offset>1.5 0.0 -0.1174</offset>
      <direction>0 0 1</direction>
    </plugin>

    <!-- ================= Disturbance ================= -->

    <plugin name="disturbance_north" filename="libgazebo_ros_thruster.so">
      <link_name>body_link</link_name>
      <ros_topic>/lander/disturbance/north</ros_topic>
      <offset>1.0 0.0 -0.5</offset>
      <direction>0 0 1</direction>
    </plugin>

    <plugin name="disturbance_east" filename="libgazebo_ros_thruster.so">
      <link_name>body_link</link_name>
      <ros_topic>/lander/disturbance/east</ros_topic>
      <offset>0.0 1.0 -0.5</offset>
      <direction>0 0 1</direction>
    </plugin>

    <plugin name="disturbance_south" filename="libgazebo_ros_thruster.so">
      <link_name>body_link</link_name>
      <ros_topic>/lander/disturbance/south</ros_topic>
      <offset>-1.0 0.0 -0.5</offset>
      <direction>0 0 1</direction>
    </plugin>

    <plugin name="disturbance_west" filename="libgazebo_ros_thruster.so">
      <link_name>body_link</link_name>
      <ros_topic>/lander/disturbance/west</ros_topic>
      <offset>0.0 -1.0 -0.5</offset>
      <direction>0 0 1</direction>
    </plugin>

    <!-- ================= MASS UPDATER ================= -->
    <!--
    <plugin name="mass_updater_plugin" filename="libgazebo_ros_mass_updater.so">
      <link_name>body_link</link_name>
    </plugin>
    -->

  </model>
</sdf>