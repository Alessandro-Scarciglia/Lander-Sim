    <joint name="joint_B2_to_E" type="ball">
      <parent>link_E</parent><child>link_B2E_piston</child>
      <pose relative_to="link_E">0 0 0 0 0 0</pose>
    </joint>

    <plugin name="crushable_df_leg2" filename="libCrushableJointPlugin.so">
      <ros><namespace>/lander</namespace></ros>
      <topic_name>leg2/df_force_displacement</topic_name>
      <joint_name>shock_absorber_DF</joint_name>
      <dual_stage>true</dual_stage>
      <stiffness>5000000.0</stiffness>
      <damping>15000.0</damping>
      <crush_force_stage_1>3000.0</crush_force_stage_1>
      <stroke_limit_stage_1>0.254</stroke_limit_stage_1>
      <crush_force_stage_2>18000.0</crush_force_stage_2>
      <total_stroke_limit>0.700</total_stroke_limit>
      <rebound_damping>15000.0</rebound_damping>
      <bottomout_stiffness>10000000.0</bottomout_stiffness>
      <compression_dir>1.0</compression_dir>
    </plugin>

    <plugin name="crushable_b1_leg2" filename="libCrushableJointPlugin.so">
      <ros><namespace>/lander</namespace></ros>
      <topic_name>leg2/b1_force_displacement</topic_name>
      <joint_name>joint_B1_prismatic</joint_name>
      <crush_force>6000.0</crush_force>
      <stiffness>5000000.0</stiffness>
      <damping>15000.0</damping>
      <rebound_damping>15000.0</rebound_damping>
      <compression_dir>1.0</compression_dir>
      <bidirectional>true</bidirectional>
      <dual_stage>false</dual_stage>
    </plugin>

    <plugin name="crushable_b2_leg2" filename="libCrushableJointPlugin.so">
