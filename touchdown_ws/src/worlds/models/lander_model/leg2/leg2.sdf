    <link name="link_foot">
      <pose relative_to="link_DF_piston">0 0 -0.5852 0 -0.3488 0</pose>
      <inertial><mass>5.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz></inertia></inertial>
      <collision name="foot_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.25</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <contact><ode><kp>5000000.0</kp><kd>50000</kd><max_vel>0.0</max_vel><min_depth>0.0</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
        <max_contacts>20</max_contacts>
      </collision>
      <visual name="footpad_visual"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.05</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      <sensor name="foot_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <contact><collision>foot_collision</collision></contact>
        <plugin name="foot_bumper_leg2" filename="libgazebo_ros_bumper.so">
          <ros><remapping>bumper_states:=/lander/contact_forces</remapping></ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="joint_D_C1" type="fixed"><parent>link_D</parent><child>link_C1D</child></joint>
    <joint name="joint_D_C2" type="fixed"><parent>link_D</parent><child>link_C2D</child></joint>
    <joint name="joint_D_A1" type="fixed"><parent>link_D</parent><child>link_A1D</child></joint>
    <joint name="joint_D_A2" type="fixed"><parent>link_D</parent><child>link_A2D</child></joint>
    
    <joint name="joint_D_DF" type="revolute">
      <parent>link_D</parent><child>link_DF_strut</child>
      <pose relative_to="link_D">0 0 0 0 0 0</pose><axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="joint_E_to_DF" type="fixed"><parent>link_DF_strut</parent><child>link_E</child></joint>

    <joint name="shock_absorber_DF" type="prismatic">
      <parent>link_DF_strut</parent><child>link_DF_piston</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0.0</lower><upper>0.70</upper><effort>100000.0</effort><velocity>3.0</velocity></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness><damping>0.0</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="joint_F_foot" type="universal">
      <parent>link_DF_piston</parent><child>link_foot</child>
      <pose>0 0 0.025 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.52</lower><upper>0.52</upper></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>200.0</spring_stiffness><damping>20.0</damping></dynamics>
      </axis>
      <axis2>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.52</lower><upper>0.52</upper></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>200.0</spring_stiffness><damping>20.0</damping></dynamics>
      </axis2>
    </joint>

    <joint name="joint_B1_prismatic" type="prismatic">
      <parent>link_B1E_strut</parent><child>link_B1E_piston</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.40</lower><upper>0.40</upper><effort>100000.0</effort><velocity>1.0</velocity></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness><damping>0.0</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="joint_B1_to_E" type="ball">
      <parent>link_E</parent><child>link_B1E_piston</child>
      <pose relative_to="link_E">0 0 0 0 0 0</pose>
    </joint>

    <joint name="joint_B2_prismatic" type="prismatic">
      <parent>link_B2E_strut</parent><child>link_B2E_piston</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.40</lower><upper>0.40</upper><effort>100000.0</effort><velocity>1.0</velocity></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness><damping>0.0</damping><friction>0.0</friction></dynamics>
