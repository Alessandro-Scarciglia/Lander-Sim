    </joint>
    <joint name="joint_E_to_DF" type="fixed"><parent>link_DF_strut</parent><child>link_E</child></joint>

    <joint name="shock_absorber_DF" type="prismatic">
      <parent>link_DF_strut</parent><child>link_DF_piston</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0.0</lower><upper>0.95</upper><effort>100000.0</effort><velocity>3.0</velocity></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness><damping>0.0</damping><friction>0.0</friction></dynamics>
