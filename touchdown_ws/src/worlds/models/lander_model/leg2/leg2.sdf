        <update_rate>50.0</update_rate>
        <contact><collision>foot_collision</collision></contact>
        <plugin name="foot_bumper_leg2" filename="libgazebo_ros_bumper.so">
          <ros><remapping>bumper_states:=/lander/contact_forces</remapping></ros>
          <frame_name>world</frame_name>
