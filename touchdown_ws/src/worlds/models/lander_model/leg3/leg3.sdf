<?xml version="1.0"?>
<!-- Template for one landing leg, including links, joints, contact sensing,
     and configurable shock absorbers. generate_legs.py creates leg1-leg4. -->
<sdf version="1.7">
  <model name="leg3">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="link_C1D">
      <pose>0.2000 0.2000 0.2250 0.0000 0.8988 0.7854</pose>
      <inertial><mass>15.0</mass><inertia><ixx>0.6591</ixx><iyy>0.6591</iyy><izz>0.0120</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="col_C1D"><geometry><cylinder><radius>0.040</radius><length>0.7228</length></cylinder></geometry></collision>
      <visual name="vis_C1D"><geometry><cylinder><radius>0.040</radius><length>0.7228</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>

    <link name="link_C2D">
      <pose>0.2000 0.6000 0.2250 0.0000 0.8988 -0.7854</pose>
      <inertial><mass>15.0</mass><inertia><ixx>0.6591</ixx><iyy>0.6591</iyy><izz>0.0120</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="col_C2D"><geometry><cylinder><radius>0.040</radius><length>0.7228</length></cylinder></geometry></collision>
      <visual name="vis_C2D"><geometry><cylinder><radius>0.040</radius><length>0.7228</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>

    <link name="link_A1D">
      <pose>0.2000 0.3000 0.7250 0.0000 2.4589 0.4636</pose>
      <inertial><mass>15.0</mass><inertia><ixx>0.6341</ixx><iyy>0.6341</iyy><izz>0.0120</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="col_A1D"><geometry><cylinder><radius>0.040</radius><length>0.7089</length></cylinder></geometry></collision>
      <visual name="vis_A1D"><geometry><cylinder><radius>0.040</radius><length>0.7089</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>

    <link name="link_A2D">
      <pose>0.2000 0.5000 0.7250 0.0000 2.4589 -0.4636</pose>
      <inertial><mass>15.0</mass><inertia><ixx>0.6341</ixx><iyy>0.6341</iyy><izz>0.0120</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="col_A2D"><geometry><cylinder><radius>0.040</radius><length>0.7089</length></cylinder></geometry></collision>
      <visual name="vis_A2D"><geometry><cylinder><radius>0.040</radius><length>0.7089</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>

    <link name="link_B1E_strut">
      <pose>0.0000 -0.2000 0.3000 0.0000 1.2066 -2.2744</pose>
      <inertial><mass>15.0</mass><inertia><ixx>0.2310</ixx><iyy>0.2310</iyy><izz>0.0188</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="strut_visual"><pose>0 0 -0.2105 0 0 0</pose><geometry><cylinder><radius>0.050</radius><length>0.4211</length></cylinder></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
    </link>

    <link name="link_B1E_piston">
      <pose relative_to="link_B1E_strut">0 0 -0.4211 0 0 0</pose>
      <inertial><mass>10.0</mass><inertia><ixx>0.1508</ixx><iyy>0.1508</iyy><izz>0.0061</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="piston_visual"><pose>0 0 -0.2105 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.4211</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>

    <link name="link_B2E_strut">
      <pose>0.0000 1.0000 0.3000 0.0000 1.2066 2.2744</pose>
      <inertial><mass>15.0</mass><inertia><ixx>0.2310</ixx><iyy>0.2310</iyy><izz>0.0188</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="strut_visual"><pose>0 0 -0.2105 0 0 0</pose><geometry><cylinder><radius>0.050</radius><length>0.4211</length></cylinder></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
    </link>

    <link name="link_B2E_piston">
      <pose relative_to="link_B2E_strut">0 0 -0.4211 0 0 0</pose>
      <inertial><mass>10.0</mass><inertia><ixx>0.1508</ixx><iyy>0.1508</iyy><izz>0.0061</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="piston_visual"><pose>0 0 -0.2105 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.4211</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>

    <link name="link_D">
      <pose>0.4000 0.4000 0.4500 0 0 0</pose>
      <inertial><mass>10.0</mass><inertia><ixx>0.040000</ixx><iyy>0.040000</iyy><izz>0.040000</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="vis"><geometry><sphere><radius>0.1</radius></sphere></geometry></visual>
    </link>

    <link name="link_E">
      <pose>0.5091 0.4000 0.0000 0 0 0</pose>
      <inertial><mass>10.0</mass><inertia><ixx>0.040000</ixx><iyy>0.040000</iyy><izz>0.040000</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="vis_E"><geometry><sphere><radius>0.1</radius></sphere></geometry></visual>
    </link>

    <link name="link_DF_strut">
      <pose>0.4000 0.4000 0.4500 0.0000 0.2378 3.1416</pose>
      <inertial><mass>15.0</mass><inertia><ixx>0.9102</ixx><iyy>0.9102</iyy><izz>0.0188</izz><ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz></inertia></inertial>
      <collision name="strut_collision"><pose>0 0 -0.4244 0 0 0</pose><geometry><cylinder><radius>0.050</radius><length>0.8489</length></cylinder></geometry></collision>
      <visual name="strut_visual"><pose>0 0 -0.4244 0 0 0</pose><geometry><cylinder><radius>0.050</radius><length>0.8489</length></cylinder></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
    </link>

    <link name="link_DF_piston">
      <pose relative_to="link_DF_strut">0 0 -0.8489 0 0 0</pose>
      <inertial><mass>10.0</mass><inertia><ixx>0.6036</ixx><iyy>0.6036</iyy><izz>0.0061</izz><ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz></inertia></inertial>
      <collision name="piston_collision"><pose>0 0 -0.4244 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.8489</length></cylinder></geometry></collision>
      <visual name="piston_visual"><pose>0 0 -0.4244 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.8489</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>

    <link name="link_foot">
      <pose relative_to="link_DF_piston">0 0 -0.8489 0 -0.2378 0</pose>
      <inertial><mass>5.0</mass><inertia><ixx>0.079167</ixx><iyy>0.079167</iyy><izz>0.156250</izz><ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz></inertia></inertial>
      <collision name="foot_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.25</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <contact><ode><kp>500000.0</kp><kd>20000.0</kd><max_vel>0.0</max_vel><min_depth>0.0</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
        <max_contacts>20</max_contacts>
      </collision>
      <visual name="footpad_visual"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.05</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      <sensor name="foot_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <contact><collision>foot_collision</collision></contact>
        <plugin name="foot_bumper_leg3" filename="libgazebo_ros_bumper.so">
          <ros><remapping>bumper_states:=/lander/contact_forces</remapping></ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- Sacrificial ground pre-detection probe: 1 m rod below the footpad -->
    <link name="link_ground_probe_leg3">
      <pose relative_to="link_foot">0 0 -0.525 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00167</ixx><iyy>0.00167</iyy><izz>0.000001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="probe_collision_leg3">
        <geometry><cylinder><radius>0.003</radius><length>1.0</length></cylinder></geometry>
      </collision>
      <visual name="probe_visual_leg3">
        <geometry><cylinder><radius>0.003</radius><length>1.0</length></cylinder></geometry>
        <material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- Contact tip at the lower end of the probe -->
    <link name="link_probe_tip_leg3">
      <pose relative_to="link_ground_probe_leg3">0 0 -0.5 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx><iyy>0.0000001</iyy><izz>0.0000001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="probe_tip_collision_leg3">
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <surface>
          <contact><ode><kp>100000</kp><kd>10</kd><max_vel>0.01</max_vel><min_depth>0.0001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="probe_tip_visual_leg3">
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
      <sensor name="probe_contact_sensor_leg3" type="contact">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <contact><collision>probe_tip_collision_leg3</collision></contact>
        <plugin name="probe_bumper_leg3" filename="libgazebo_ros_bumper.so">
          <ros>
            <remapping>bumper_states:=/lander/leg3/probe_contact</remapping>
          </ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- Probe attachment -->
    <joint name="joint_foot_probe_leg3" type="fixed">
      <parent>link_foot</parent>
      <child>link_ground_probe_leg3</child>
    </joint>

    <joint name="joint_probe_tip_leg3" type="fixed">
      <parent>link_ground_probe_leg3</parent>
      <child>link_probe_tip_leg3</child>
    </joint>

    <joint name="joint_D_C1" type="fixed"><parent>link_D</parent><child>link_C1D</child></joint>
    <joint name="joint_D_C2" type="fixed"><parent>link_D</parent><child>link_C2D</child></joint>
    <joint name="joint_D_A1" type="fixed"><parent>link_D</parent><child>link_A1D</child></joint>
    <joint name="joint_D_A2" type="fixed"><parent>link_D</parent><child>link_A2D</child></joint>
    
    <joint name="joint_D_DF" type="revolute">
      <parent>link_D</parent><child>link_DF_strut</child>
      <pose relative_to="link_D">0 0 0 0 0 0</pose><axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="joint_E_to_DF" type="fixed"><parent>link_DF_strut</parent><child>link_E</child></joint>

    <joint name="shock_absorber_DF" type="prismatic">
      <parent>link_DF_strut</parent><child>link_DF_piston</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0.0</lower><upper>0.95</upper><effort>100000.0</effort><velocity>3.0</velocity></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness><damping>0.0</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="joint_F_foot" type="universal">
      <parent>link_DF_piston</parent><child>link_foot</child>
      <pose>0 0 0.025 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.52</lower><upper>0.52</upper></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>254.7</spring_stiffness><damping>26.9</damping></dynamics>
      </axis>
      <axis2>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.52</lower><upper>0.52</upper></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>254.7</spring_stiffness><damping>26.9</damping></dynamics>
      </axis2>
    </joint>

    <joint name="joint_B1_prismatic" type="prismatic">
      <parent>link_B1E_strut</parent><child>link_B1E_piston</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.40</lower><upper>0.40</upper><effort>100000.0</effort><velocity>1.0</velocity></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness><damping>0.0</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="joint_B1_to_E" type="ball">
      <parent>link_E</parent><child>link_B1E_piston</child>
      <pose relative_to="link_E">0 0 0 0 0 0</pose>
    </joint>

    <joint name="joint_B2_prismatic" type="prismatic">
      <parent>link_B2E_strut</parent><child>link_B2E_piston</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.40</lower><upper>0.40</upper><effort>100000.0</effort><velocity>1.0</velocity></limit>
        <dynamics><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness><damping>0.0</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="joint_B2_to_E" type="ball">
      <parent>link_E</parent><child>link_B2E_piston</child>
      <pose relative_to="link_E">0 0 0 0 0 0</pose>
    </joint>

    <plugin name="crushable_df_leg3" filename="libCrushableJointPlugin.so">
      <ros><namespace>/lander</namespace></ros>
      <topic_name>leg3/df_force_displacement</topic_name>
      <joint_name>shock_absorber_DF</joint_name>
      <dual_stage>true</dual_stage>
      <stiffness>86531.5</stiffness>
      <damping>19358.5</damping>
      <crush_force_stage_1>7830.1</crush_force_stage_1>
      <stroke_limit_stage_1>0.400</stroke_limit_stage_1>
      <crush_force_stage_2>20191.8</crush_force_stage_2>
      <total_stroke_limit>0.900</total_stroke_limit>
      <rebound_damping>13725.0</rebound_damping>
      <bottomout_stiffness>9174031.4</bottomout_stiffness>
      <compression_dir>1.0</compression_dir>
    </plugin>

    <plugin name="crushable_b1_leg3" filename="libCrushableJointPlugin.so">
      <ros><namespace>/lander</namespace></ros>
      <topic_name>leg3/b1_force_displacement</topic_name>
      <joint_name>joint_B1_prismatic</joint_name>
      <crush_force>4180774.3</crush_force>
      <stiffness>3959594.3</stiffness>
      <damping>188348.7</damping>
      <rebound_damping>144245.0</rebound_damping>
      <compression_dir>1.0</compression_dir>
      <bidirectional>true</bidirectional>
      <dual_stage>false</dual_stage>
    </plugin>

    <plugin name="crushable_b2_leg3" filename="libCrushableJointPlugin.so">
      <ros><namespace>/lander</namespace></ros>
      <topic_name>leg3/b2_force_displacement</topic_name>
      <joint_name>joint_B2_prismatic</joint_name>
      <crush_force>4180774.3</crush_force>
      <rebound_damping>144245.0</rebound_damping>
      <stiffness>3959594.3</stiffness>
      <damping>188348.7</damping>
      <compression_dir>1.0</compression_dir>
      <bidirectional>true</bidirectional>
      <dual_stage>false</dual_stage>
    </plugin>

  </model>
</sdf>