<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="passenger">
    <link name="passenger_link">
      
      <!-- INERZIA, MASSA, COG -->
      <inertial>
        <mass>{PASS_MASS}</mass>
        <!-- CoG locale rispetto a RF2 -->
        <pose>{PASS_COG_X} {PASS_COG_Y} {PASS_COG_Z} 0 0 0</pose> 
        <inertia>
          <ixx>{PASS_IXX}</ixx>
          <iyy>{PASS_IYY}</iyy>
          <izz>{PASS_IZZ}</izz>
          <ixy>{PASS_IXY}</ixy>
          <ixz>{PASS_IXZ}</ixz>
          <iyz>{PASS_IYZ}</iyz>
        </inertia>
      </inertial>

      <!-- PARTE VISIVA -->
      <visual name="passenger_visual">
        <geometry>
          <mesh>            
            <uri>model://lander_model/meshes/passenger.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>        
      </visual>

      <!-- PARTE DI COLLISIONE -->
      <collision name="passenger_collision">
        <geometry>
          <mesh>
            <uri>model://lander_model/meshes/passenger.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>100000000.0</kp>
              <kd>100000.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>

          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1.0</threshold>
          </bounce>
        </surface>
        <max_contacts>20</max_contacts>
      </collision>

    </link>
  </model>
</sdf>